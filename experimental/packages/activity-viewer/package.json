{
  "name": "@platypus/activity-viewer",
  "version": "0.1.0",
  "description": "Reusable React component for inspecting Android activity view trees produced by platypus-rehydrate. Consumed by both the standalone platypus-viewer app and the Project Platypus main UI.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/viewer.css"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "dev": "vite --port 5180",
    "build": "tsc --noEmit",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
